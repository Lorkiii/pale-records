// Defines PALE's persisted users, classes, students, Attendance, Recitation, and Agenda data.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum RecitationMark {
  CHECK
  X
}

enum AgendaEventType {
  EXAM
  ASSIGNMENT
  ACTIVITY
  HOLIDAY
  MEETING
  NOTE
}

model User {
  id           String   @id @default(uuid())
  firstName    String
  lastName     String
  /// Optional unique login name for accounts created before username support.
  username     String?  @unique
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  agendaEvents AgendaEvent[]
}

model Student {
  id         String    @id @default(uuid())
  studentNo  String?   @unique
  firstName  String
  lastName   String
  archivedAt DateTime?

  enrollments       StudentEnrollment[]
  attendanceRecords AttendanceRecord[]
  recitationRecords RecitationRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lastName, firstName])
}

model Class {
  id          String    @id @default(uuid())
  subjectName String
  subjectCode String?
  section     String?
  schoolYear  String?
  semester    String?
  teacher     String?
  room        String?
  startDate   DateTime?
  endDate     DateTime?
  archivedAt  DateTime?

  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  classSchedules             ClassSchedule[]
  attendanceSessions         AttendanceSession[]
  attendanceMonthGenerations AttendanceMonthGeneration[]
  recitationSessions         RecitationSession[]
  agendaEvents               AgendaEvent[]
  enrollments                StudentEnrollment[]
}

model AgendaEvent {
  id          String          @id @default(uuid())
  userId      String
  classId     String?
  title       String          @db.VarChar(160)
  description String?         @db.VarChar(2000)
  eventDate   DateTime        @db.Date
  startTime   String?         @db.VarChar(5)
  endTime     String?         @db.VarChar(5)
  isAllDay    Boolean
  eventType   AgendaEventType
  location    String?         @db.VarChar(160)
  legacyImportKey String?      @unique @db.VarChar(200)

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  class Class? @relation(fields: [classId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, eventDate])
  @@index([classId])
}

model StudentEnrollment {
  studentId String
  classId   String

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@id([studentId, classId])
  @@index([classId, studentId])
}

model ClassSchedule {
  id        String @id @default(uuid())
  classId   String
  dayOfWeek Int
  startTime String
  endTime   String

  class              Class               @relation(fields: [classId], references: [id], onDelete: Cascade)
  attendanceSessions AttendanceSession[]

  @@unique([classId, dayOfWeek])
}

model AttendanceSession {
  id                  String    @id @default(uuid())
  classId             String
  classScheduleId     String?
  sessionDate         DateTime  @db.Date
  startTime           String?
  endTime             String?
  rosterInitializedAt DateTime?

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  classSchedule ClassSchedule? @relation(fields: [classScheduleId], references: [id], onDelete: SetNull)

  attendanceRecords AttendanceRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classId, sessionDate])
  @@index([classScheduleId])
}

model AttendanceMonthGeneration {
  id         String   @id @default(uuid())
  classId    String
  monthStart DateTime @db.Date
  createdAt  DateTime @default(now())

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([classId, monthStart])
}

model AttendanceRecord {
  id        String            @id @default(uuid())
  sessionId String
  studentId String
  status    AttendanceStatus?
  remarks   String?           @db.VarChar(1000)

  attendanceSession AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, studentId])
  @@index([studentId])
}

model RecitationSession {
  id                  String    @id @default(uuid())
  classId             String
  sessionDate         DateTime  @db.Date
  rosterInitializedAt DateTime?

  class             Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  recitationRecords RecitationRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classId, sessionDate])
}

model RecitationRecord {
  id        String          @id @default(uuid())
  sessionId String
  studentId String
  mark      RecitationMark?

  recitationSession RecitationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student           Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, studentId])
  @@index([studentId])
}
